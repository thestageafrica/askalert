{
  "$schema": "https://turbo.build/schema.json",
  "globalEnv": [
    "ADMIN_BASIC_USER",
    "ADMIN_BASIC_PASSWORD",
    "NEXT_PUBLIC_SITE_URL",
    "NEXT_PUBLIC_WHATSAPP_NUMBER",
    "USE_SUPABASE",
    "NEXT_PUBLIC_USE_SUPABASE",
    "NEXT_PUBLIC_SUPABASE_URL",
    "NEXT_PUBLIC_SUPABASE_ANON_KEY",
    "SUPABASE_URL",
    "SUPABASE_ANON_KEY",
    "SUPABASE_SERVICE_ROLE_KEY"
  ],
  "globalPassThroughEnv": [
    "ADMIN_BASIC_USER",
    "ADMIN_BASIC_PASSWORD",
    "NEXT_PUBLIC_SITE_URL",
    "NEXT_PUBLIC_WHATSAPP_NUMBER",
    "USE_SUPABASE",
    "NEXT_PUBLIC_USE_SUPABASE",
    "NEXT_PUBLIC_SUPABASE_URL",
    "NEXT_PUBLIC_SUPABASE_ANON_KEY",
    "SUPABASE_URL",
    "SUPABASE_ANON_KEY",
    "SUPABASE_SERVICE_ROLE_KEY"
  ],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": [".next/**", "!.next/cache/**", "dist/**"],
      "env": [
        "ADMIN_BASIC_USER",
        "ADMIN_BASIC_PASSWORD",
        "NEXT_PUBLIC_SITE_URL",
        "NEXT_PUBLIC_WHATSAPP_NUMBER",
        "USE_SUPABASE",
        "NEXT_PUBLIC_USE_SUPABASE",
        "NEXT_PUBLIC_SUPABASE_URL",
        "NEXT_PUBLIC_SUPABASE_ANON_KEY",
        "SUPABASE_URL",
        "SUPABASE_ANON_KEY",
        "SUPABASE_SERVICE_ROLE_KEY"
      ]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "lint": {
      "dependsOn": ["^build"]
    },
    "typecheck": {
      "dependsOn": ["^build"]
    },
    "test": {
      "dependsOn": ["^build"]
    }
  }
}
