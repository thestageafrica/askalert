{
  "name": "askalert",
  "private": true,
  "packageManager": "pnpm@9.15.9",
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "db:generate-seed": "node scripts/generate-seed.mjs",
    "db:push": "supabase db push --remote --yes",
    "db:seed": "supabase db query --remote --yes -f supabase/seed.sql"
  },
  "devDependencies": {
    "prettier": "^3.5.3",
    "supabase": "^3.2.0",
    "turbo": "^2.5.4",
    "typescript": "^5.8.3"
  },
  "engines": {
    "node": ">=20"
  }
}
