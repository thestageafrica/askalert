{
  "slug": "home-care",
  "name": "Home care",
  "icon": "sparkles",
  "status": "pilot",
  "pricing_mode": "range",
  "negotiation": "assisted",
  "autopilot_max_rounds": 1,
  "commission_pct": 12,
  "escrow": {
    "mode": "fixed",
