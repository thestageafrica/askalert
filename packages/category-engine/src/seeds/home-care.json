    "At least one Lagos reference",
    "Own tools or disclosed kit fee"
  ],
  "media_allowed": ["photo", "voice_note"],
  "max_vendors_per_mission": 4,
  "response_deadline_minutes": 90,
  "attributes": [
    {
      "key": "service_type",
      "label": "Service type",
      "type": "select",
      "required": true,
      "applies_to": "both",
      "options": ["cleaning", "laundry", "cooking", "deep_clean", "other"]
    },
    {
      "key": "property_type",
      "label": "Property type",
      "type": "select",
      "required": true,
      "applies_to": "need",
      "options": ["apartment", "duplex", "office", "studio"]
    },
    {
      "key": "frequency",
      "label": "Frequency",
      "type": "select",
      "required": true,
      "applies_to": "need",
      "options": ["one_off", "weekly", "biweekly", "monthly"]
    },
    {
      "key": "preferred_time",
      "label": "Preferred time",
      "type": "select",
      "required": true,
      "applies_to": "need",
      "options": ["morning", "afternoon", "evening", "flexible"]
    },
    {
      "key": "area",
      "label": "Area",
      "type": "area",
      "required": true,
      "applies_to": "both",
      "validation": { "min_length": 2, "max_length": 80 }
    },
    {
      "key": "budget",
      "label": "Budget",
      "type": "money",
      "required": true,
      "applies_to": "need",
      "unit": "kobo",
      "validation": { "min": 500000 }
    },
    {
      "key": "quote_amount",
      "label": "Quote amount",
      "type": "money",
      "required": true,
      "applies_to": "offer",
      "unit": "kobo",
      "validation": { "min": 500000 }
    }
  ],
  "agent": {
    "tone": "Respectful and direct.",
    "extra_rules": [
      "Confirm access instructions before booking.",
      "Flag any visit that needs materials the buyer must buy."
    ],
    "negotiation_hints": [
      "Ask for a same-day slot only when the buyer is flexible on time.",
      "Bundle cleaning and laundry when it saves a second trip."
    ]
  },
  "ranking_weights": {
    "price": 0.25,
    "rating": 0.3,
    "response_speed": 0.25,
    "proximity": 0.15,
    "fit": 0.05
