# Public site URL (no trailing slash). Use your Vercel URL or custom domain in production.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# WhatsApp business number in international format, digits only (no + or spaces).
# Example: 2348012345678
NEXT_PUBLIC_WHATSAPP_NUMBER=2348000000000

# Optional: enable Vercel Analytics after installing @vercel/analytics (see DEPLOY.md).
# NEXT_PUBLIC_VERCEL_ANALYTICS=1
