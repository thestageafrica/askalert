# Public site URL (no trailing slash). Production: https://www.askalert.com
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# WhatsApp business number in international format, digits only (no + or spaces).
# Placeholder 2348000000000 shows a dev warning and fails production builds.
NEXT_PUBLIC_WHATSAPP_NUMBER=2348000000000

# Supabase (off by default → mock categories for local dev)
NEXT_PUBLIC_USE_SUPABASE=false
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
