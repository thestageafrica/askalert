# Keep these 200 rewrites for category shells only.
# Do NOT rewrite /app/request/:id or /app/chat/:id here — that would also
# catch /app/request/open and /app/chat/open. New asks use ?id= on /open/.

/app/new/* /app/new/shortlets/index.html 200
/app/new/*/ /app/new/shortlets/index.html 200

/app/notifications /app/notifications/index.html 200
/app/notifications/ /app/notifications/index.html 200
