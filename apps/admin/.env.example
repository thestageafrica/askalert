# Public admin URL (no trailing slash). Production: https://admin.askalert.com
NEXT_PUBLIC_SITE_URL=http://localhost:3001

# Optional WhatsApp digits if admin surfaces share links.
NEXT_PUBLIC_WHATSAPP_NUMBER=2348000000000

# Protect admin with Cloudflare Access (Basic Auth middleware removed for static export).
# Do not put SUPABASE_SERVICE_ROLE_KEY in Pages — browser uses the anon key only.
NEXT_PUBLIC_USE_SUPABASE=false
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
