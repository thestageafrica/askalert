# Local / secrets reference for Edge Functions. Never commit real values.
# Copy to .env, then fill real values:
#   Copy-Item supabase\functions\.env.example supabase\functions\.env
# Upload:
#   pnpm exec supabase secrets set --env-file ./supabase/functions/.env --yes
#
# Generate SEND_EMAIL_HOOK_SECRET in Dashboard → Authentication → Hooks → Send Email.

RESEND_API_KEY=re_xxxxxxxx
SEND_EMAIL_HOOK_SECRET=v1,whsec_PLACEHOLDER_REPLACE_IN_STEP_4
EMAIL_FROM=AskAlert <auth@askalert.com>
EMAIL_LOGO_URL=https://www.askalert.com/brand/askalert-logo-email.png
EMAIL_SITE_URL=https://www.askalert.com

# Optional HTTP fallback (not SMTP)
# BREVO_API_KEY=
# EMAIL_FALLBACK=brevo

# Prompt 29 — in-app agent (never put these in Pages / browser env)
# ANTHROPIC_API_KEY=sk-ant-...
# AGENT_ROUTINE_MODEL=claude-haiku-4-5-20251001
# AGENT_HARD_MODEL=claude-sonnet-4-5-20250929
