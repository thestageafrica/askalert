# Production web: https://www.askalert.com (never vercel.app). Placeholder WhatsApp fails prod builds.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_WHATSAPP_NUMBER=2348000000000

# Admin is protected by Cloudflare Access on static hosting (no Basic Auth env).

# Supabase (Prompt 15 free plan). Keep secrets in .env.local — never commit them.
# Leave USE_SUPABASE=false (or unset) to keep mock category seeds locally.
USE_SUPABASE=false
NEXT_PUBLIC_USE_SUPABASE=false
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Web Push (VAPID) — never commit real keys. Generate with:
#   npx --yes web-push generate-vapid-keys
# Public key is safe for the browser; private key is Edge-only.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=   # supabase secrets set only
# VAPID_SUBJECT=mailto:ops@askalert.com

# Auth emails — Send Email Hook + Resend (HTTP). Do not put SMTP passwords in the repo.
# See docs/AUTH.md and supabase/functions/.env.example
# RESEND_API_KEY=re_xxx
# SEND_EMAIL_HOOK_SECRET=v1,whsec_xxx
# EMAIL_FROM=AskAlert <auth@askalert.com>
# Optional fallback (Brevo Transactional HTTP API, not SMTP):
# BREVO_API_KEY=
# EMAIL_FALLBACK=brevo
# TEST_EMAIL=you@example.com

# Absolute HTTPS logo for transactional emails (Gmail-safe). Must be publicly reachable.
NEXT_PUBLIC_EMAIL_LOGO_URL=https://www.askalert.com/brand/askalert-logo-email.png
# EMAIL_LOGO_URL=https://www.askalert.com/brand/askalert-logo-email.png
# EMAIL_SITE_URL=https://www.askalert.com

# Auth redirects (set matching URLs in Supabase Auth settings)
# NEXT_PUBLIC_SITE_URL must match the browser origin used for magic links / OAuth.

# Edge Function secrets (set with `supabase secrets set`, not in git)
# WEBHOOK_SHARED_SECRET=
# CRON_SHARED_SECRET=
# RESEND_API_KEY=
# SEND_EMAIL_HOOK_SECRET=
# EMAIL_FROM=
# BREVO_API_KEY=

# apps/edge-webhooks (set via `wrangler secret put`, not Pages env)
# WHATSAPP_VERIFY_TOKEN=
# WHATSAPP_APP_SECRET=
# PAYSTACK_SECRET=
# WEBHOOK_SHARED_SECRET=
# SUPABASE_FUNCTION_URL=https://YOUR_PROJECT_REF.supabase.co/functions/v1/ingest-webhook

# GitHub Actions (repository secrets) — backup + keep-alive
# SUPABASE_DB_URL_READONLY=
# BACKUP_GPG_PASSPHRASE=
# SUPABASE_SCRATCH_DB_URL=
# KEEPALIVE_HEALTH_URL=https://askalert.pages.dev/health.json
# Optional S3: BACKUP_S3_BUCKET, BACKUP_S3_ACCESS_KEY_ID, BACKUP_S3_SECRET_ACCESS_KEY, BACKUP_S3_REGION

