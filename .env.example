# Production web: https://www.askalert.com (never vercel.app). Placeholder WhatsApp fails prod builds.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_WHATSAPP_NUMBER=2348000000000

# Admin is protected by Cloudflare Access on static hosting (no Basic Auth env).

# Supabase (Prompt 15 free plan). Keep secrets in .env.local — never commit them.
# Leave USE_SUPABASE=false (or unset) to keep mock category seeds locally.
USE_SUPABASE=false
NEXT_PUBLIC_USE_SUPABASE=false
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Edge Function secrets (set with `supabase secrets set`, not in git)
# WEBHOOK_SHARED_SECRET=
# CRON_SHARED_SECRET=

# apps/edge-webhooks (set via `wrangler secret put`, not Pages env)
# WHATSAPP_VERIFY_TOKEN=
# WHATSAPP_APP_SECRET=
# PAYSTACK_SECRET=
# WEBHOOK_SHARED_SECRET=
# SUPABASE_FUNCTION_URL=https://YOUR_PROJECT_REF.supabase.co/functions/v1/ingest-webhook

# GitHub Actions (repository secrets) — backup + keep-alive
# SUPABASE_DB_URL_READONLY=
# BACKUP_GPG_PASSPHRASE=
# SUPABASE_SCRATCH_DB_URL=
# KEEPALIVE_HEALTH_URL=https://askalert.pages.dev/health.json
# Optional S3: BACKUP_S3_BUCKET, BACKUP_S3_ACCESS_KEY_ID, BACKUP_S3_SECRET_ACCESS_KEY, BACKUP_S3_REGION

